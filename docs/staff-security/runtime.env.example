# Configuration contract for a future explicitly approved release.
# Both features remain disabled until that release is authorized.
# This is a preparation template, NOT a runnable post-migration configuration.
# After the security migrations, STAFF_SECURITY_ENABLED must be true before
# serving authentication; disabling only STAFF_DASHBOARD_ENABLED is containment.
STAFF_SECURITY_ENABLED=false
STAFF_DASHBOARD_ENABLED=false
# Required when enabling the dashboard in production: up to 200 positive IDs.
STAFF_DASHBOARD_USER_IDS=
# Provision JWT_SECRET and STAFF_ACCESS_SIGNING_SECRET independently in the secret
# manager (at least 32 bytes each). Match the staff key to the protected DB key.
# Preserve the existing 32-byte base64 APP_ENC_KEY for existing authenticators.
# Runtime uses chatforia_dev. Migration/recovery credentials stay outside the app.
